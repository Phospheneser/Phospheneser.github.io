    {
      "id": "moss-image-release",
      "date": "2026.10.16",
      "translations": {
        "en": {
          "content": "<a href=\"https://github.com/OpenMOSS/MOSS-Image\">MOSS-Image</a> is now open source, with code and model weights for MOSS-Image-Base and MOSS-Image-SFT available!"
        },
        "zh": {
          "content": "<a href=\"https://github.com/OpenMOSS/MOSS-Image\">MOSS-Image</a> 已开源，发布 MOSS-Image-Base、MOSS-Image-SFT 的代码与模型权重！"
        },
        "jp": {
          "content": "<a href=\"https://github.com/OpenMOSS/MOSS-Image\">MOSS-Image</a> をオープンソースとして公開しました。MOSS-Image-Base と MOSS-Image-SFT のコードとモデル重みが利用可能です！"
        }
      },
      "featuredOrder": 1
    },
    {
      "id": "cutetts-paper",
      "date": "2026.08.09",
      "translations": {
        "en": {
          "content": "<a href=\"https://arxiv.org/abs/2608.08638\">CuteTTS</a>: our paper on efficient, high-quality speech synthesis with continuous autoregressive modeling is now on arXiv!"
        },
        "zh": {
          "content": "<a href=\"https://arxiv.org/abs/2608.08638\">CuteTTS</a> 论文已发布！探索基于连续潜变量自回归建模的高效、高质量语音合成。"
        },
        "jp": {
          "content": "<a href=\"https://arxiv.org/abs/2608.08638\">CuteTTS</a> の論文を arXiv に公開しました！連続潜在変数の自己回帰モデリングによる高効率・高品質な音声合成を探究します。"
        }
      }
    },
    {
      "id": "omnivae-paper",
      "date": "2026.07.26",
      "translations": {
        "en": {
          "content": "<a href=\"https://arxiv.org/abs/2607.23855\">OmniVAE</a>: our paper on cross-modal alignment in audio-video VAEs for joint generation is now on arXiv!"
        },
        "zh": {
          "content": "<a href=\"https://arxiv.org/abs/2607.23855\">OmniVAE</a> 论文已发布！通过音视频 VAE 的跨模态对齐，提升音视频联合生成的质量与同步效果。"
        },
        "jp": {
          "content": "<a href=\"https://arxiv.org/abs/2607.23855\">OmniVAE</a> の論文を arXiv に公開しました！音声・映像 VAE のクロスモーダル整合により、共同生成の品質と同期精度を高めます。"
        }
      }
    },
    {
      "id": "etc-paper",
      "date": "2026.06.07",
      "translations": {
        "en": {
          "content": "<a href=\"https://arxiv.org/abs/2606.08520\">Two Bridges, One Pathway (ETC)</a>: our paper on transferring VLMs to generalizable VLAs using embodied trajectory-coupled data is now on arXiv!"
        },
        "zh": {
          "content": "<a href=\"https://arxiv.org/abs/2606.08520\">Two Bridges, One Pathway (ETC)</a> 论文已发布！利用具身轨迹耦合数据，探索从视觉语言模型到可泛化机器人策略的迁移。"
        },
        "jp": {
          "content": "<a href=\"https://arxiv.org/abs/2606.08520\">Two Bridges, One Pathway (ETC)</a> の論文を arXiv に公開しました！身体化された軌跡と結び付いたデータを用い、視覚言語モデルから汎化可能なロボット方策への転移を探究します。"
        }
      }
    },
