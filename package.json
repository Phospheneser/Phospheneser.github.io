{
  "name": "academic-homepage",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "validate": "node scripts/validate-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run validate && npm test",
    "verify:migration": "node scripts/verify-migration.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "build": "npm run prepare:assets && npm run check"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "sharp": "0.35.5"
  }
}
